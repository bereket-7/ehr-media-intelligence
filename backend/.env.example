# EHR Media Intelligence Platform - Environment Configuration
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT
# IMPORTANT: DO NOT STORE REAL SECRETS OR PHI IN SOURCE CONTROL

# Application & Environment
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Storage & Persistence
SQLITE_DB_PATH=./ehr_intelligence.db
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Summarization (Optional LLM Key - Deterministic offline fallback is used when blank)
OPENAI_API_KEY=
LLM_PROVIDER=offline_fallback
LLM_MODEL=none

# Semantic Search
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
